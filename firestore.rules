rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // NEW: true when the login's email is verified (email accounts after
    // clicking the link; Google accounts always). Required for anything
    // other users see: posts, ratings and comments.
    function emailVerified() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    // NEW: moderators. An admin is a user with a doc admins/{uid}, added
    // by hand in the Firebase Console. No app can create one (rule below).
    // Checked last in each rule, so normal users don't pay for the lookup.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      // You may only check whether YOU are an admin.
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // NEW: reports of posts, comments or profile pictures, for admins.
    // Doc id = {reporter uid}_{target_key}, so each user reports a thing once.
    match /reports/{reportId} {
      allow create: if emailVerified()
        && request.resource.data.keys().hasOnly(['reporter_id', 'target_key',
             'type', 'post_id', 'comment_id', 'target_user_id', 'reason', 'created_at'])
        && request.resource.data.reporter_id == request.auth.uid
        && request.resource.data.target_key is string
        && request.resource.data.target_key.size() <= 300
        && reportId == request.auth.uid + '_' + request.resource.data.target_key
        && request.resource.data.type in ['post', 'comment', 'avatar']
        && request.resource.data.post_id is string
        && request.resource.data.post_id.size() <= 300
        && (request.resource.data.get('comment_id', null) == null
            || (request.resource.data.comment_id is string
                && request.resource.data.comment_id.size() <= 300))
        && request.resource.data.target_user_id is string
        && request.resource.data.target_user_id != request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 300
        && request.resource.data.created_at == request.time;
      // Reporters may check their own report (by its id) to avoid duplicates.
      allow get: if request.auth != null
        && (reportId.matches('^' + request.auth.uid + '_.*') || isAdmin());
      allow list, delete: if isAdmin();
      allow update: if false;
    }



    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /generation_requests/{id} {
      allow create: if request.auth != null
                    && request.resource.data.user_id == request.auth.uid;
      allow read: if request.auth != null
                  && resource.data.user_id == request.auth.uid;
    }

    match /recipes/{id} {
      allow create: if request.auth != null
                    && request.resource.data.user_id == request.auth.uid;
      allow read, update, delete: if request.auth != null
                                  && resource.data.user_id == request.auth.uid;
    }


    match /categories/{id} {
      allow create: if request.auth != null
                    && request.resource.data.user_id == request.auth.uid;
      allow read, update, delete: if request.auth != null
                                  && resource.data.user_id == request.auth.uid;
    }

    match /saved_recipes/{id} {
      allow create: if request.auth != null
                    && request.resource.data.user_id == request.auth.uid;
      allow read, update, delete: if request.auth != null
                                  && resource.data.user_id == request.auth.uid;
    }


    // NEW: unique usernames. usernames/{username} = { user_id, created_at }.
    // The document id IS the username, so two accounts can never share one:
    // creating a doc that already exists counts as an update, which is denied.
    // Holds no email or other private data.
    match /usernames/{username} {
      // Sign-up checks "is this name free?" before the account exists.
      // One name at a time only: nobody can list every username.
      allow get: if true;
      allow list: if false;
      // Claim: only for yourself, only a valid name, and only together with
      // setting users/{uid}.username to the same name (same transaction).
      allow create: if request.auth != null
        && username.matches('^[a-z0-9._]{3,20}$')
        && request.resource.data.user_id == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;
      // Free your old name when changing it (users/{uid}.username moved on).
      allow delete: if request.auth != null
        && resource.data.user_id == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('username', '') != username;
      allow update: if false;
    }

    // NEW: public name + avatar, readable by any signed-in user.
    // users/{uid} stays private (rule above is unchanged).
    match /public_profiles/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.user_id == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && (request.resource.data.get('avatar_b64', null) == null
            || (request.resource.data.avatar_b64 is string
                && request.resource.data.avatar_b64.size() <= 60000))
        && (request.resource.data.get('photo_url', null) == null
            || (request.resource.data.photo_url is string
                && request.resource.data.photo_url.size() <= 2048));
      // NEW: an admin may only remove the custom picture (set it to null).
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avatar_b64'])
        && request.resource.data.avatar_b64 == null;
      allow delete: if false;
    }


    match /posted_recipes/{postId} {
      // NEW (likes + sorting): counters live in post_stats/{postId}, not on
      // the post, so a like or comment never re-sends the post's photo.
      // Every like / comment / rating must bump its counter in the same
      // batch or transaction; post_stats checks each change against it.
      function statsPath() {
        return /databases/$(database)/documents/post_stats/$(postId);
      }
      function statBefore(field) {
        return exists(statsPath()) ? get(statsPath()).data.get(field, 0) : 0;
      }
      function statChangedBy(field, delta) {
        return existsAfter(statsPath())
          && getAfter(statsPath()).data.get(field, 0) == statBefore(field) + delta;
      }

      allow read: if request.auth != null;
      allow create: if emailVerified()
                    && request.resource.data.user_id == request.auth.uid
                    // NEW: optional recipe photo (base64 JPEG)
                    && (request.resource.data.get('photo_b64', null) == null
                        || (request.resource.data.photo_b64 is string
                            && request.resource.data.photo_b64.size() <= 400000));
      // NEW: admins may delete any post.
      allow delete: if request.auth != null
                    && (resource.data.user_id == request.auth.uid || isAdmin());

      // NEW: one like per user; the like count goes up/down with it.
      match /likes/{userId} {
        allow read: if request.auth != null;
        allow create: if emailVerified()
          && userId == request.auth.uid
          && request.resource.data.keys().hasOnly(['user_id', 'post_id', 'created_at'])
          && request.resource.data.user_id == request.auth.uid
          && statChangedBy('like_count', 1);
        allow delete: if (request.auth != null
                          && userId == request.auth.uid
                          && statChangedBy('like_count', -1))
                      || isAdmin();
      }

      match /ratings/{userId} {
        allow read: if request.auth != null;
        allow create: if emailVerified()
          && userId == request.auth.uid
          && request.resource.data.user_id == request.auth.uid
          && request.resource.data.rating_value is int
          && request.resource.data.rating_value >= 1
          && request.resource.data.rating_value <= 5
          && get(/databases/$(database)/documents/posted_recipes/$(postId)).data.user_id != request.auth.uid
          // NEW: the rating count goes up in the same write.
          && statChangedBy('rating_count', 1);
        // NEW: admins clean up the ratings of a post they delete.
        allow delete: if isAdmin();
      }

      match /comments/{commentId} {
        // NEW: photo_b64 is null or a base64 string within the limit.
        function validCommentPhoto() {
          return request.resource.data.get('photo_b64', null) == null
            || (request.resource.data.photo_b64 is string
                && request.resource.data.photo_b64.size() <= 400000);
        }

        // NEW: a like/unlike may only add or remove your own uid.
        function onlyOwnLikeChanged() {
          let before = resource.data.get('liked_by', []).toSet();
          let afterList = request.resource.data.liked_by;
          let after = afterList.toSet();
          return afterList.size() == after.size()   // no duplicates
            && after.difference(before).union(before.difference(after))
                 .hasOnly([request.auth.uid]);
        }

        allow read: if request.auth != null;
        allow create: if emailVerified()
          && request.resource.data.user_id == request.auth.uid
          && request.resource.data.comment_text.size() <= 500
          // NEW: text, photo, or both, but never empty
          && (request.resource.data.comment_text.size() > 0
              || request.resource.data.get('photo_b64', null) != null)
          && validCommentPhoto()
          // NEW: replies point at a top-level comment id (null = top-level)
          && (request.resource.data.get('parent_id', null) == null
              || request.resource.data.parent_id is string)
          && (request.resource.data.get('reply_to_user_name', null) == null
              || (request.resource.data.reply_to_user_name is string
                  && request.resource.data.reply_to_user_name.size() <= 80))
          // NEW: new comments start undeleted with no likes
          && request.resource.data.get('deleted', false) == false
          && request.resource.data.get('liked_by', []).size() == 0
          // NEW: the comment count goes up in the same write.
          && statChangedBy('comment_count', 1);
        // NEW: author soft-delete (deleted / comment_text / photo_b64 only),
        // or any signed-in user liking/unliking (liked_by only, own uid).
        allow update: if request.auth != null && (
          (resource.data.user_id == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['deleted', 'comment_text', 'photo_b64'])
            && request.resource.data.get('deleted', false) is bool
            && request.resource.data.comment_text is string
            && request.resource.data.comment_text.size() <= 500
            && validCommentPhoto())
          ||
          (request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['liked_by'])
            && request.resource.data.liked_by is list
            && onlyOwnLikeChanged())
        );
        // NEW: admins may delete any comment.
        allow delete: if request.auth != null
                      && (resource.data.user_id == request.auth.uid || isAdmin());
      }
    }



    // NEW (likes + sorting): counters per post, used to sort the feed by
    // Most liked / Most commented / Top rated. Each change must match a
    // like, comment or rating written in the same batch/transaction.
    match /post_stats/{postId} {
      function postPath() {
        return /databases/$(database)/documents/posted_recipes/$(postId);
      }
      function subPath(kind, id) {
        return /databases/$(database)/documents/posted_recipes/$(postId)/$(kind)/$(id);
      }
      function before(field) {
        return resource == null ? 0 : resource.data.get(field, 0);
      }
      function after(field) {
        return request.resource.data.get(field, 0);
      }
      function same(field) {
        return after(field) == before(field);
      }
      function sameLastComment() {
        return request.resource.data.get('last_comment_id', '')
          == (resource == null ? '' : resource.data.get('last_comment_id', ''));
      }
      function validShape() {
        return request.resource.data.keys().hasOnly([
            'like_count', 'comment_count', 'rating_count', 'rating_sum',
            'rating_avg', 'last_comment_id'])
          && after('like_count') is int && after('like_count') >= 0
          && after('comment_count') is int && after('comment_count') >= 0
          && after('rating_count') is int && after('rating_count') >= 0
          && after('rating_sum') is int && after('rating_sum') >= 0
          && (after('rating_avg') is int || after('rating_avg') is float);
      }
      // New post: its owner creates (or resets) the counters at zero in the
      // same batch that creates the post.
      function zeroInit() {
        return !exists(postPath())
          && after('like_count') == 0 && after('comment_count') == 0
          && after('rating_count') == 0 && after('rating_sum') == 0
          && after('rating_avg') == 0
          && !('last_comment_id' in request.resource.data)
          && getAfter(postPath()).data.user_id == request.auth.uid;
      }
      // +1 with your new like, -1 with your removed like.
      function likeChange() {
        let like = subPath('likes', request.auth.uid);
        return same('comment_count') && same('rating_count')
          && same('rating_sum') && same('rating_avg') && sameLastComment()
          && ((after('like_count') == before('like_count') + 1
                && !exists(like) && existsAfter(like))
            || (after('like_count') == before('like_count') - 1
                && exists(like) && !existsAfter(like)));
      }
      // +1 with a new comment; -1 when a live comment is deleted or
      // soft-deleted. last_comment_id names that comment.
      function commentChange() {
        let comment = subPath('comments',
            request.resource.data.get('last_comment_id', '_none'));
        return request.resource.data.get('last_comment_id', '') is string
          && same('like_count') && same('rating_count')
          && same('rating_sum') && same('rating_avg')
          && ((after('comment_count') == before('comment_count') + 1
                && !exists(comment) && existsAfter(comment))
            || (after('comment_count') == before('comment_count') - 1
                && exists(comment)
                && get(comment).data.get('deleted', false) == false
                && (!existsAfter(comment)
                    || getAfter(comment).data.get('deleted', false) == true)));
      }
      // Your new rating: count +1, sum + your stars, average = sum / count.
      function ratingChange() {
        let rating = subPath('ratings', request.auth.uid);
        return same('like_count') && same('comment_count') && sameLastComment()
          && !exists(rating) && existsAfter(rating)
          && after('rating_count') == before('rating_count') + 1
          && after('rating_sum') == before('rating_sum')
               + getAfter(rating).data.rating_value
          && math.abs(after('rating_avg')
               - float(after('rating_sum')) / float(after('rating_count'))) < 0.001;
      }

      allow read: if request.auth != null;
      // Admins may set any valid counts (the one-time recount of old posts).
      allow create, update: if request.auth != null && validShape()
        && (zeroInit() || likeChange() || commentChange() || ratingChange()
            || isAdmin());
      // With the post (owner deleting it in the same batch), or by an admin.
      allow delete: if isAdmin()
        || (request.auth != null
            && exists(postPath())
            && get(postPath()).data.user_id == request.auth.uid
            && !existsAfter(postPath()));
    }
  }
}
